# ==============================================================================
# Deskbird Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration (used by server/)
# ------------------------------------------------------------------------------
# Port for the Express + Socket.IO server to listen on.
# Render automatically injects PORT in production. Default for local: 3001
PORT=3001

# Node environment: 'development', 'production', or 'test'
NODE_ENV=development

# Comma-separated list of allowed origins for Socket.IO CORS & Express.
# In local development: http://localhost:5173
# In production: https://your-deskbird-web.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Maximum number of offline messages stored in memory per bird room (default: 20)
MAX_QUEUE=20

# Time-to-live for unread queued messages in milliseconds (default: 86400000 = 24 hours)
MESSAGE_TTL_MS=86400000

# Expected interval for bird client heartbeats in milliseconds (default: 240000 = 4 minutes)
HEARTBEAT_EXPECTED_MS=240000

# ------------------------------------------------------------------------------
# Web Client Configuration (used by web/ at build time)
# ------------------------------------------------------------------------------
# The backend Socket.IO server URL that the static web client connects to.
# Local development: http://localhost:3001
# Production (Render): https://deskbird-server.onrender.com
VITE_SERVER_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Desktop Bird App Configuration (bird/)
# ------------------------------------------------------------------------------
# Optional override for the server endpoint that the desktop bird connects to.
# If omitted, uses DEFAULT_SERVER_URL configured in bird/src/main/config.js.
# In local development, passing --local sets this to http://localhost:3001.
DESKBIRD_SERVER=http://localhost:3001

