    "pixel-art",
    "desktop-pet",
    "overlay",
    "companion"
  ],
  "author": "rish170",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rish170/deskbird/issues"
  },
  "homepage": "https://github.com/rish170/deskbird#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
